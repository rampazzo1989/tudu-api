PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://tudu_user:tudu_password@localhost:5432/tudu_db?schema=public

# Security & Auth
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
REVENUECAT_WEBHOOK_AUTH_TOKEN=auth_token_from_revenuecat_dashboard

# Google Auth Client ID (optional in dev, used for token verification)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# AI Routing Strategy: single | fallback | cost_optimized
AI_ROUTING_STRATEGY=fallback
AI_DEFAULT_PROVIDER=deepseek

# DeepSeek Credentials
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_FAST=deepseek-chat
DEEPSEEK_MODEL_REASONING=deepseek-chat

# OpenAI Credentials (2 production models from Tudú app)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_PARSE=gpt-5.6-luna

# Anti-Abuse Daily Caps (even for subscribers)
AI_MAX_EMOJI_PER_DAY=200
AI_MAX_PARSE_PER_DAY=50
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=25
